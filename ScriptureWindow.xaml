<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Read Scripture — Selah" Width="760" Height="660" MinWidth="560" MinHeight="430"
        WindowStartupLocation="CenterScreen" Style="{StaticResource DialogWindow}" Topmost="True">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource IconTile}" Background="#8764B8" VerticalAlignment="Top"><TextBlock Text="&#xE736;" Style="{StaticResource Icon}" FontSize="17" Foreground="White" HorizontalAlignment="Center"/></Border>
      <StackPanel Grid.Column="1" Margin="14,0,12,0">
        <TextBlock x:Name="ScriptureVersionLabel" Text="BEREAN STANDARD BIBLE" Style="{StaticResource AccentCaption}"/>
        <TextBlock x:Name="ScriptureReference" FontFamily="{StaticResource DisplayFont}" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
      </StackPanel>
      <Border Grid.Column="2" Background="{DynamicResource CardAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="ScriptureBsbButton" Content="BSB" Style="{StaticResource SegmentButton}" MinWidth="54"/>
          <Button x:Name="ScriptureKjvButton" Content="KJV" Style="{StaticResource SegmentButton}" MinWidth="54"/>
        </StackPanel>
      </Border>
    </Grid>
    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="8">
      <FlowDocumentScrollViewer x:Name="ScriptureDoc" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsToolBarVisible="False" Foreground="{DynamicResource Text}"/>
    </Border>
    <DockPanel Grid.Row="4">
      <Button x:Name="ScriptureNivButton" Style="{StaticResource GhostButton}" DockPanel.Dock="Left" ToolTip="Open the same passage in the NIV on BibleGateway">
        <StackPanel Orientation="Horizontal"><TextBlock Text="Read in NIV"/><TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="11" Margin="8,0,0,0"/></StackPanel>
      </Button>
      <Button x:Name="ScriptureCloseButton" Content="Done" Style="{StaticResource PrimaryButton}" Width="100" HorizontalAlignment="Right" IsCancel="True"/>
    </DockPanel>
  </Grid>
</Window>
